theme = TokyoNight

# =========================
# ENV
# =========================
env = TERM=xterm-256color
env = WINIT_X11_SCALE_FACTOR=1

# =========================
# WINDOW & TABS
# =========================
title = "Term"
window-width = 100
window-height = 30
window-padding-x = 4
window-padding-y = 4
window-decoration = true
background-opacity = 0.97
class = "Ghostty"

# Pozycja paska kart
gtk-tabs-location = bottom

# =========================
# SCROLLING
# =========================
scrollback-limit = 100000

# =========================
# FONT
# =========================
font-family = "monospace"
font-size = 12

# =========================
# SELECTION & CURSOR
# =========================
copy-on-select = true
selection-invert-fg-bg = true
cursor-style = underline
cursor-style-blink = false

# =========================
# KEYBOARD BINDINGS (STRICT 1.3.1 FORMAT)
# =========================

# Kopiowanie/Wklejanie
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Splity (Używamy cudzysłowu dla bezpieczeństwa przy parametrach)
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+backslash=new_split:right

# Nawigacja między splitami (Alt + Strzałki)
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right

# Przełączanie kart (Używamy cyfr 1-5 zamiast słów "one", "two")
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5

# Scroll i inne
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = ctrl+0=reset_font_size

# =========================
# MISC
# =========================
mouse-hide-while-typing = false
confirm-close-surface = false
shell-integration = zsh

